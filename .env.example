# ============================================================
# HomePower — 環境變數設定
# 複製此檔案為 .env.local 並填入實際的值
# cp .env.example .env.local
# ============================================================

# --------------------------------------------------
# 1. Supabase (必要)
#    申請：https://supabase.com/dashboard → New Project
#    取得：Project Settings → API
#    登入方式：Email + Password + Passkey (WebAuthn)
#    設定：Authentication → Providers → 開啟 Email
#    Passkey：Authentication → MFA → 開啟 WebAuthn
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --------------------------------------------------
# 2. Supabase Service Role Key (必要)
#    Supabase Dashboard → Settings → API → service_role key
#    用於 MCP API token 驗證（繞過 RLS，程式內手動過濾 user_id）
# --------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# 3. 中央氣象署 Open API (天氣預報)
#    申請：https://opendata.cwa.gov.tw → 註冊會員 → 取得授權碼
#    免費，需登入後至「資料使用說明」取得 API Key
# --------------------------------------------------
CWA_API_KEY=

# --------------------------------------------------
# 4. OpenAI API (AI Chat 功能 + 網路搜尋)
#    申請：https://platform.openai.com/api-keys
#    需綁定付款方式，依用量計費
#    網路搜尋使用 OpenAI 內建的 web search tool
# --------------------------------------------------
OPENAI_API_KEY=
# 可選：指定 OpenAI 模型（預設：gpt-5.1-codex-mini）
# OPENAI_MODEL=gpt-5.1-codex-mini
