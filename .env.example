# ============================================================
# HomePower — 環境變數設定
# 複製此檔案為 .env.local 並填入實際的值
# cp .env.local.example .env.local
# ============================================================

# --------------------------------------------------
# 1. Supabase (必要)
#    申請：https://supabase.com/dashboard → New Project
#    取得：Project Settings → API
#    設定 OAuth：Authentication → Providers → 開啟 Google / GitHub
#    Redirect URL 設為：http://localhost:3000/auth/callback
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --------------------------------------------------
# 2. Google OAuth (必要，登入用)
#    申請：https://console.cloud.google.com/apis/credentials
#    步驟：建立 OAuth 2.0 Client ID → Web application
#         Authorized redirect URIs 加入：
#         https://<your-supabase-project>.supabase.co/auth/v1/callback
#    取得 Client ID 和 Secret 後，填入 Supabase Dashboard：
#         Authentication → Providers → Google
# --------------------------------------------------

# --------------------------------------------------
# 3. GitHub OAuth (必要，登入用)
#    申請：https://github.com/settings/developers → New OAuth App
#    Homepage URL：http://localhost:3000
#    Authorization callback URL：
#         https://<your-supabase-project>.supabase.co/auth/v1/callback
#    取得 Client ID 和 Secret 後，填入 Supabase Dashboard：
#         Authentication → Providers → GitHub
# --------------------------------------------------

# --------------------------------------------------
# 4. 中央氣象署 Open API (天氣預報)
#    申請：https://opendata.cwa.gov.tw → 註冊會員 → 取得授權碼
#    免費，需登入後至「資料使用說明」取得 API Key
# --------------------------------------------------
CWA_API_KEY=

# --------------------------------------------------
# 5. OpenAI API (AI Chat 功能)
#    申請：https://platform.openai.com/api-keys
#    需綁定付款方式，依用量計費
# --------------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------------
# 6. Tavily API (AI Agent 網路搜尋工具)
#    申請：https://tavily.com → Sign Up → API Keys
#    免費方案每月 1,000 次搜尋
# --------------------------------------------------
TAVILY_API_KEY=
